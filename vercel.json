{
  "version": 2,
  "builds": [
    { "src": "api/**/*.js", "use": "@vercel/node" },
    { "src": "public/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/(.*)", "dest": "/public/$1" }
  ],
  "env": {
    "OGIMAGE_SIGNING_SECRET": "@ogimage-signing-secret",
    "APP_URL": "https://getogimage.com",
    "APP_NAME": "OG Image API"
  }
}
